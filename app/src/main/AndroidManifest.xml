<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      docs/plans/mvp/foreground-service-setup/PLAN.md §1 (MVP subset)。
      RECEIVE_BOOT_COMPLETED は quiet-hours 機能実装時まで意図的に除外
      (docs/plans/other/auto-stop-conditions/PLAN-3-quiet-hours.md 参照)。
      SYSTEM_ALERT_WINDOW は不要 (docs/DECISIONS.md §18 で生 overlay window 方式を廃止済み)。
      BIND_NOTIFICATION_LISTENER_SERVICE は <uses-permission> ではなく、
      NotificationSyncListenerService の <service> 要素側で宣言済み (下記参照)。
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtuaLed">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VirtuaLed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          docs/plans/mvp/notification-detection-dot-indicator/PLAN.md §1, §3.
          BIND_NOTIFICATION_LISTENER_SERVICE はシステムがバインド時に要求する権限であり、
          <uses-permission> ではなく <service> の android:permission 属性として宣言する。
        -->
        <service
            android:name=".service.NotificationSyncListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          docs/plans/mvp/foreground-service-setup/PLAN.md §1 (verbatim)。
          specialUse タイプの正当化 (Google Play 提出時に必要になる説明) は
          docs/DECISIONS.md §5 参照 (現状は個人利用/限定テスト配布のため未対応)。
        -->
        <service
            android:name=".service.VirtuaLedForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screen-notification-indicator-overlay" />
        </service>

        <!--
          docs/plans/mvp/fake-sleep-overlay/PLAN.md §5 (verbatim)。
          full-screen-intent 通知経由で OS が起動するため exported=false で問題ない。
        -->
        <activity
            android:name=".overlay.FakeSleepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VirtuaLed.FakeSleep" />
    </application>

</manifest>

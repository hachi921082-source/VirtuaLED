<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      機能固有の <uses-permission> はまだ含めていない (このプランでは不要)。
      Foreground Service / full-screen-intent 等、他の権限は
      それぞれの MVP PLAN.md 実装が担当する (docs/detailed-spec.md §2 参照)。
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtuaLed">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VirtuaLed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          docs/plans/mvp/notification-detection-dot-indicator/PLAN.md §1, §3.
          BIND_NOTIFICATION_LISTENER_SERVICE はシステムがバインド時に要求する権限であり、
          <uses-permission> ではなく <service> の android:permission 属性として宣言する。
        -->
        <service
            android:name=".service.NotificationSyncListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      docs/plans/mvp/foreground-service-setup/PLAN.md §1 (MVP subset)。
      SYSTEM_ALERT_WINDOW は不要 (docs/DECISIONS.md §18 で生 overlay window 方式を廃止済み)。
      BIND_NOTIFICATION_LISTENER_SERVICE は <uses-permission> ではなく、
      NotificationSyncListenerService の <service> 要素側で宣言済み (下記参照)。
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      docs/plans/other/auto-stop-conditions/PLAN-3-quiet-hours.md §7。このアプリで唯一
      RECEIVE_BOOT_COMPLETED を要求する機能 (クワイエットアワーの AlarmManager 予約を
      端末再起動後に再登録するため)。SCHEDULE_EXACT_ALARM は不要 (docs/DECISIONS.md §10)。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      docs/plans/other/importance-based-sizing/PLAN.md §3、
      docs/plans/other/category-icons-and-assets/PLAN.md §4。InstalledAppPicker.kt の
      queryIntentActivities(ACTION_MAIN/CATEGORY_LAUNCHER) がキーワード登録/カテゴリ設定
      画面のアプリ選択一覧に使う問い合わせ。Android 11 (API 30) 以降のパッケージ可視性制限により、
      この <queries> 宣言が無いと LINE/Gmail 等の一般アプリが結果に含まれず、一部の
      システムアプリしか一覧に出ない (実機テストで発見)。QUERY_ALL_PACKAGES (Google Play
      制限付き権限) は使わず、この用途に必要な最小限の可視性のみを宣言する。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtuaLed">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VirtuaLed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          docs/plans/mvp/notification-detection-dot-indicator/PLAN.md §1, §3.
          BIND_NOTIFICATION_LISTENER_SERVICE はシステムがバインド時に要求する権限であり、
          <uses-permission> ではなく <service> の android:permission 属性として宣言する。
        -->
        <service
            android:name=".service.NotificationSyncListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          docs/plans/mvp/foreground-service-setup/PLAN.md §1 (verbatim)。
          specialUse タイプの正当化 (Google Play 提出時に必要になる説明) は
          docs/DECISIONS.md §5 参照 (現状は個人利用/限定テスト配布のため未対応)。
        -->
        <service
            android:name=".service.VirtuaLedForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screen-notification-indicator-overlay" />
        </service>

        <!--
          docs/plans/mvp/fake-sleep-overlay/PLAN.md §5 (verbatim)。
          full-screen-intent 通知経由で OS が起動するため exported=false で問題ない。
        -->
        <activity
            android:name=".overlay.FakeSleepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VirtuaLed.FakeSleep" />

        <!--
          docs/plans/mvp/onoff-notification-toggle/PLAN.md §4。FGS 通知の ON/OFF アクションボタンの
          PendingIntent 送信先。アプリ内からのみ発行する PendingIntent 経由で呼ばれるため exported=false。
        -->
        <receiver
            android:name=".receiver.OnOffActionReceiver"
            android:exported="false" />

        <!--
          docs/plans/other/auto-stop-conditions/PLAN-3-quiet-hours.md §5, §7 (verbatim)。
          端末再起動後にクワイエットアワーの AlarmManager 予約を再登録するための唯一の
          BOOT_COMPLETED 受信者 (このアプリで唯一 RECEIVE_BOOT_COMPLETED を使用)。
        -->
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          docs/plans/other/auto-stop-conditions/PLAN-3-quiet-hours.md §4, §7。QuietHoursScheduler
          が発行する PendingIntent 経由でのみ到達するため、OnOffActionReceiver 同様 exported=false。
        -->
        <receiver
            android:name=".receiver.QuietHoursAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
